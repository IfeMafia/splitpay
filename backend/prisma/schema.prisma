datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PoolStatus {
  ACTIVE
  ARCHIVED
}

enum PoolRole {
  OWNER
  MEMBER
}

enum InvitationType {
  CODE
  EMAIL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum SplitType {
  EQUAL
  CUSTOM
}

enum AllocationStatus {
  ALLOCATED
  WITHDRAWN
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  fullName        String   @map("full_name")
  phone           String?
  defaultCurrency String   @default("NGN") @map("default_currency")
  country         String?  @default("NG")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ownedPools      Pool[]         @relation("PoolOwner")
  poolMemberships PoolMember[]
  notifications   Notification[]
  auditLogs       AuditLog[]     @relation("Actor")

  @@map("users")
}

model Pool {
  id          String     @id @default(uuid())
  ownerId     String     @map("owner_id")
  name        String
  description String?
  currency    String     @default("NGN")
  status      PoolStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner               User                 @relation("PoolOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             PoolMember[]
  invitations         PoolInvitation[]
  paymentLinks        PaymentLink[]
  transactions        Transaction[]
  splitConfigurations SplitConfiguration[]
  splitSnapshots      SplitSnapshot[]
  withdrawals         Withdrawal[]

  @@index([ownerId])
  @@map("pools")
}

model PoolMember {
  id        String   @id @default(uuid())
  poolId    String   @map("pool_id")
  userId    String   @map("user_id")
  role      PoolRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pool        Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations SplitAllocation[]
  withdrawals Withdrawal[]

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
  @@map("pool_members")
}

model PoolInvitation {
  id        String           @id @default(uuid())
  poolId    String           @map("pool_id")
  inviterId String           @map("inviter_id")
  type      InvitationType   @default(CODE)
  code      String?          @unique
  email     String?
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([token])
  @@index([code])
  @@map("pool_invitations")
}

model PaymentLink {
  id          String   @id @default(uuid())
  poolId      String   @map("pool_id")
  token       String   @unique
  title       String
  description String?
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("NGN")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pool         Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([poolId])
  @@index([token])
  @@map("payment_links")
}

model Transaction {
  id                String        @id @default(uuid())
  poolId            String        @map("pool_id")
  paymentLinkId     String?       @map("payment_link_id")
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @default("NGN")
  provider          String        @default("paystack")
  providerReference String?       @unique @map("provider_reference")
  status            PaymentStatus @default(PENDING)
  payerEmail        String?       @map("payer_email")
  payerName         String?       @map("payer_name")
  metadata          Json?
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  pool          Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)
  paymentLink   PaymentLink?       @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  events        TransactionEvent[]
  splitSnapshot SplitSnapshot?

  @@index([poolId])
  @@index([providerReference])
  @@map("transactions")
}

model TransactionEvent {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  eventType     String   @map("event_type")
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_events")
}

model SplitConfiguration {
  id            String    @id @default(uuid())
  poolId        String    @map("pool_id")
  type          SplitType @default(EQUAL)
  configuration Json
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@map("split_configurations")
}

model SplitSnapshot {
  id                  String    @id @default(uuid())
  poolId              String    @map("pool_id")
  transactionId       String    @unique @map("transaction_id")
  type                SplitType
  snapshotData        Json      @map("snapshot_data")
  totalAmount         Decimal   @map("total_amount") @db.Decimal(18, 2)
  distributableAmount Decimal   @map("distributable_amount") @db.Decimal(18, 2)
  createdAt           DateTime  @default(now()) @map("created_at")

  pool        Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  transaction Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  allocations SplitAllocation[]

  @@index([poolId])
  @@map("split_snapshots")
}

model SplitAllocation {
  id           String           @id @default(uuid())
  snapshotId   String           @map("snapshot_id")
  poolMemberId String           @map("pool_member_id")
  percentage   Decimal          @db.Decimal(5, 2)
  amount       Decimal          @db.Decimal(18, 2)
  currency     String           @default("NGN")
  status       AllocationStatus @default(ALLOCATED)
  createdAt    DateTime         @default(now()) @map("created_at")

  snapshot   SplitSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  poolMember PoolMember    @relation(fields: [poolMemberId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([poolMemberId])
  @@map("split_allocations")
}

model Withdrawal {
  id                String           @id @default(uuid())
  poolId            String           @map("pool_id")
  poolMemberId      String           @map("pool_member_id")
  amount            Decimal          @db.Decimal(18, 2)
  currency          String           @default("NGN")
  status            WithdrawalStatus @default(PENDING)
  providerReference String?          @unique @map("provider_reference")
  bankCode          String?          @map("bank_code")
  accountNumber     String?          @map("account_number")
  accountName       String?          @map("account_name")
  failureReason     String?          @map("failure_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  pool       Pool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  poolMember PoolMember        @relation(fields: [poolMemberId], references: [id], onDelete: Cascade)
  events     WithdrawalEvent[]

  @@index([poolId])
  @@index([poolMemberId])
  @@map("withdrawals")
}

model WithdrawalEvent {
  id           String   @id @default(uuid())
  withdrawalId String   @map("withdrawal_id")
  eventType    String   @map("event_type")
  data         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@map("withdrawal_events")
}

model LedgerAccount {
  id           String   @id @default(uuid())
  accountType  String   @map("account_type")
  poolId       String?  @map("pool_id")
  poolMemberId String?  @map("pool_member_id")
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  amount      Decimal  @db.Decimal(18, 2)
  type        String
  description String?
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("ledger_entries")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_log")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}

